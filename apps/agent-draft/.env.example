# Copy to .env and fill in. Every variable the platform reads is listed here.

# ── Required ────────────────────────────────────────────────────────────────
# Strong password for the bundled Postgres.
POSTGRES_PASSWORD=change-me
# 32 random bytes, base64. Encrypts every stored API key. Losing it makes saved keys unreadable.
#   openssl rand -base64 32
MASTER_KEY=
# First admin account, created only when no admin exists yet.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-password

# ── Addressing / TLS ────────────────────────────────────────────────────────
# Public origin users type in the browser (used in invite and reset links, cookie security).
PUBLIC_URL=http://localhost:8080
# Caddy site address. A hostname (e.g. agent.example.com) enables automatic HTTPS (ports 80/443
# must be reachable). ":80" serves plain HTTP, which is only acceptable on localhost.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
# Refuse non-HTTPS requests on non-localhost hosts (redirects to https). Keep true in production.
REQUIRE_HTTPS=true
# Trust X-Forwarded-* from Caddy.
TRUST_PROXY=true
# Extra CORS origins, comma-separated (only needed for a separate dev frontend).
CORS_ORIGINS=

# ── Server behaviour ────────────────────────────────────────────────────────
NODE_ENV=production
LOG_LEVEL=info
SESSION_TTL_HOURS=336
MASTER_KEY_VERSION=1
# Failed logins allowed per email within the window; the per-IP ceiling is 5x this.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MIN=15

# ── Email (optional; without it the admin copies invite/reset links) ───────
# e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL=
SMTP_FROM=Lathe <no-reply@example.com>

# ── Sandboxes ───────────────────────────────────────────────────────────────
SANDBOX_IMAGE=agent-sandbox-base:latest
# Docker runtime for sandboxes: runc (default) or runsc if gVisor is installed on the host.
SANDBOX_RUNTIME=runc
SANDBOX_PREFIX=agent-sbx
PREVIEW_TOKEN_TTL_HOURS=12

# ── Subscription CLI mode (admin only; optional) ────────────────────────────
# Needs: docker compose --profile cli build cli-runner, then log in once per CLI
# (see README). Uses the vendors' own unmodified CLIs under your own login.
CLI_RUNNER_ENABLED=false
CLI_RUNNER_IMAGE=agent-cli-runner:latest
CLI_HOME_VOLUME=agent-cli-home
CLI_RUN_TIMEOUT_S=1800
